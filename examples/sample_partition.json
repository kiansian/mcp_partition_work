      "is_reset": false,
      "timing_critical": false
    }
  ],
  "interfaces": [
    {
      "name": "COMPUTE_MEMORY_UCIe",
      "partition_a": "COMPUTE",
      "partition_b": "MEMORY",
      "max_bandwidth_gbps": 2048.0,
      "latency_ns": 5.0,
      "protocol": "UCIe",
      "pin_count": 2048
    },
    {
      "name": "COMPUTE_IO_UCIe",
      "partition_a": "COMPUTE",
      "partition_b": "IO",
      "max_bandwidth_gbps": 512.0,
      "latency_ns": 8.0,
      "protocol": "UCIe",
      "pin_count": 512
    }
  ]
}
