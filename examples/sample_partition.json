    {
      "name": "io_rx_data",
      "source_partition": "IO",
      "sink_partitions": ["COMPUTE"],
      "width": 64,
      "frequency_mhz": 1000.0,
      "is_clock": false,
      "is_reset": false,
      "timing_critical": false
    },
    {
      "name": "io_status",
      "source_partition": "IO",
      "sink_partitions": ["COMPUTE"],
      "width": 16,
      "frequency_mhz": 100.0,
      "is_clock": false,
      "is_reset": false,
      "timing_critical": false
    },
    {
      "name": "cpu_internal_bus",
      "source_partition": "COMPUTE",
      "sink_partitions": ["COMPUTE"],
      "width": 512,
      "frequency_mhz": 3200.0,
      "is_clock": false,
      "is_reset": false,
      "timing_critical": true
    },
    {
      "name": "mem_internal_refresh",
      "source_partition": "MEMORY",
